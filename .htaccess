# ============================================================
# .htaccess — Reglas de seguridad del proyecto
# ============================================================

# --- SEC-01: Bloquear acceso web directo a archivos sensibles ---
<FilesMatch "^\.env$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear también archivos de configuración y logs
<FilesMatch "\.(log|sql|bak|sh|git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso directo al directorio .git
RedirectMatch 404 /\.git

# --- SEGURIDAD GENERAL ---
# Ocultar la versión de Apache y PHP en las cabeceras
ServerSignature Off

# Prevenir listado de directorios
Options -Indexes

# Proteger contra clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# Activar XSS protection en navegadores legacy
Header always set X-XSS-Protection "1; mode=block"

# Prevenir MIME-type sniffing
Header always set X-Content-Type-Options "nosniff"
